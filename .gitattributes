*.jpg            binary
*.jpeg           binary
*.gif            binary
*.webp           binary
*.ico            binary
*.icns           binary
*.ttf            binary
*.otf            binary
*.woff           binary
*.woff2          binary
*.exe            binary
*.dll            binary
*.so             binary
*.dylib          binary
*.a              binary
*.lib            binary
*.zip            binary
*.gz             binary
*.xz             binary
*.7z             binary
